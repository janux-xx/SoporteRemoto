{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aleux Soporte Remoto - Técnico",
  "version": "0.4.0",
  "identifier": "mx.SOME.aleux.remote.support",
  "build": {
    "frontendDist": "../src/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev --prefix src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Aleux Soporte Remoto - Técnico",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}